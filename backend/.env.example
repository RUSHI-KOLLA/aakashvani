# Copy to .env and fill in. NEVER commit .env
HOST=127.0.0.1
PORT=8000
CUDA_VISIBLE_DEVICES=0
HF_HOME=~/.cache/huggingface

# IITM FastSpeech2 + HiFi-GAN single-language checkpoint dir (~160 MB).
# Backend TTS ONLY (translation is done in-extension via Chrome built-in).

# Per-language on-demand checkpoint downloads (~160MB each).
# Publish zips named te.zip / hi.zip / kn.zip / ta.zip / ml.zip / mr.zip at this
# base URL (e.g. your own HuggingFace dataset repo's resolve/main/ URL).
# Each zip contains model.pth + config.yaml (+ optional hifigan/). If private,
# set HF_TOKEN or keep ~/.cache/huggingface/token (used automatically).
TTS_CHECKPOINT_BASE_URL="https://huggingface.co/smtiitm/FastSpeech2_HS_latest_models/resolve/main"
TTS_GENDER=female
# HF_TOKEN="hf_..."

