# Copy to .env and fill in. NEVER commit .env
HOST=127.0.0.1
PORT=8000
CUDA_VISIBLE_DEVICES=0
HF_HOME=~/.cache/huggingface

# Sarvam AI (cloud translation) — BYOK, used when mode=cloud or auto-fallback
# Get key at https://dashboard.sarvam.ai
# SARVAM_API_KEY="sk_..."
# SARVAM_BASE_URL="https://api.sarvam.ai"
# SARVAM_NMT_MODEL="mayura:v1"

# Piper ONNX TTS — voices download on demand from rhasspy/piper-voices (~40-65 MB each)
PIPER_VOICES_BASE_URL="https://huggingface.co/rhasspy/piper-voices/resolve/main"
PIPER_MODEL_DIR=~/.cache/aakashvani/piper_voices
# HF_TOKEN="hf_..."

# Piper tuning
PIPER_TTS_MAX_WORKERS=1
PIPER_TTS_MAX_CHARS=1200
