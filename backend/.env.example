# Copy to .env and fill in. NEVER commit .env
HOST=127.0.0.1
PORT=8000
CUDA_VISIBLE_DEVICES=0
HF_HOME=~/.cache/huggingface

# IITM FastSpeech2 + HiFi-GAN single-language checkpoint dir (~160 MB).
# Backend TTS ONLY (translation is done in-extension via Chrome built-in).
TTS_MODEL_DIR=./checkpoints/iitm_fastspeech2
