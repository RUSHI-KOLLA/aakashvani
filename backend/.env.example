# Copy to .env and fill in. NEVER commit .env
HOST=127.0.0.1
PORT=8000
CUDA_VISIBLE_DEVICES=0
HF_HOME=~/.cache/huggingface

# Sarvam AI Cloud (translation + optional cloud TTS). BYOK.
SARVAM_API_KEY=""
SARVAM_BASE_URL="https://api.sarvam.ai"
SARVAM_NMT_MODEL="mayura:v1"
SARVAM_TTS_MODEL="bulbul:v3"

# Single-language IITM FastSpeech2 + HiFi-GAN checkpoint dir (~160 MB)
TTS_MODEL_DIR=./checkpoints/iitm_fastspeech2
