# Copy to .env and fill in. NEVER commit .env
HOST=127.0.0.1
PORT=8000
CUDA_VISIBLE_DEVICES=0
HF_HOME=~/.cache/huggingface

# Sarvam AI (cloud translation) — BYOK, used when mode=cloud or auto-fallback
# Get key at https://dashboard.sarvam.ai
# SARVAM_API_KEY="sk_..."
# SARVAM_BASE_URL="https://api.sarvam.ai"
# SARVAM_NMT_MODEL="mayura:v1"

# Per-language on-demand IITM checkpoint downloads (~160MB each).
TTS_CHECKPOINT_BASE_URL="https://huggingface.co/smtiitm/FastSpeech2_HS_latest_models/resolve/main"
TTS_GENDER=female
# HF_TOKEN="hf_..."

